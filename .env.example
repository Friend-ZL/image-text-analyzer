# Database Configuration (PostgreSQL container)
POSTGRES_DB=analyzer_db
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=your_secure_password_here

# Application datasource. Spring Boot reads DATABASE_* (not DB_*).
DATABASE_URL=jdbc:postgresql://localhost:5432/analyzer_db
DATABASE_USERNAME=analyzer
DATABASE_PASSWORD=your_secure_password_here

# AI Service Configuration
DASHSCOPE_API_KEY=your_api_key_here
