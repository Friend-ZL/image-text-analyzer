# ============================================
# 应用配置
# ============================================
# 阿里云 DashScope API Key（必填）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ============================================
# PostgreSQL 容器（镜像读取 POSTGRES_*）
# ============================================
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=analyzer_db

# ============================================
# 应用数据源与 Flyway（与 application.yml 一致）
# 这里的 URL 给宿主机上的 IDE 用（localhost:5432）。
# compose 里的 app 服务会改写成 jdbc:postgresql://postgres:5432/${POSTGRES_DB}。
#
# DATABASE_USERNAME 固定为 app_rw，不再等于 POSTGRES_USER。
# DATABASE_FLYWAY_* 是迁移 owner，要和上面的 POSTGRES_USER / POSTGRES_PASSWORD 相同。
# DATABASE_PASSWORD 与 DATABASE_APP_RW_PASSWORD 必须是同一个值：
# 后者由 Flyway V3 设到角色上，前者是应用登录用的密码。
# 下面全是占位，不要填真实密码。V3 是创建 app_rw 的唯一路径。
# ============================================
DATABASE_URL=jdbc:postgresql://localhost:5432/analyzer_db
DATABASE_USERNAME=app_rw
DATABASE_PASSWORD=change_me
DATABASE_FLYWAY_USERNAME=analyzer
DATABASE_FLYWAY_PASSWORD=your_database_password_here
DATABASE_APP_RW_PASSWORD=change_me

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=your_redis_password_here

# ============================================
# MinIO 配置
# 服务已暂时从 compose 中去掉（公开镜像需要认证）。保留变量，恢复服务时再用。
# ============================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=your_minio_password_here

# ============================================
# Keycloak 配置
# ============================================
# Keycloak 26 起用这两个变量创建初始管理员。
# KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD 已弃用。
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=your_keycloak_password_here

# 浏览器和本机工具访问 Keycloak 的地址（宿主机端口 8180，容器内监听 8080）。
# 必须是带协议的完整 URL。compose 把它设为 KC_HOSTNAME。
# 启动时导入 realm「analyzer」，其中包含客户端 image-text-analyzer。
# token 的 iss 固定为 ${KC_HOSTNAME}/realms/analyzer
# 即默认 http://localhost:8180/realms/analyzer
# 不要改成 http://keycloak:8080，否则和浏览器拿到的 iss 不一致。
KC_HOSTNAME=http://localhost:8180

# ============================================
# JWT（compose 以 prod profile 启动应用时必填）
# 对应 application.yml 的 app.security.jwt.issuer / jwk-set-uri / audience。
# 非 dev/local profile 三者缺一，应用拒绝启动。
# ============================================
# 必须与 token 里的 iss 逐字相同：${KC_HOSTNAME}/realms/analyzer
JWT_ISSUER_URI=http://localhost:8180/realms/analyzer

# 应用容器拉取公钥的地址。用 compose 服务名和容器端口 8080。
# 容器内的 localhost 不是 Keycloak。
# 在宿主机上跑应用时改成 http://localhost:8180/realms/analyzer/protocol/openid-connect/certs。
JWT_JWK_SET_URI=http://keycloak:8080/realms/analyzer/protocol/openid-connect/certs

# 期望受众。令牌 aud 包含该值，或 azp 等于该值，才通过。
# 对齐 realm analyzer 里的客户端 ID image-text-analyzer。
JWT_AUDIENCE=image-text-analyzer

# 可选。角色还读取 resource_access.<JWT_CLIENT_ID>.roles。默认 image-text-analyzer。
JWT_CLIENT_ID=image-text-analyzer

# 可选。时钟偏差，Spring Duration 或纯秒数。默认 60s。负数会导致启动失败。
JWT_CLOCK_SKEW_SECONDS=60s
