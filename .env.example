# ============================================
# 应用配置
# ============================================
# 阿里云 DashScope API Key（必填）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ============================================
# PostgreSQL 配置
# ============================================
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=analyzer_db

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=your_redis_password_here

# ============================================
# MinIO 配置
# 服务已暂时从 compose 中去掉（公开镜像需要认证）。保留变量，恢复服务时再用。
# ============================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=your_minio_password_here

# ============================================
# Keycloak 配置
# ============================================
# Keycloak 26 起用这两个变量创建初始管理员。
# KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD 已弃用。
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=your_keycloak_password_here

# 浏览器和本机工具访问 Keycloak 的地址（宿主机端口 8180，容器内监听 8080）。
# 必须是带协议的完整 URL。compose 把它设为 KC_HOSTNAME，token 的 iss 固定为：
#   ${KC_HOSTNAME}/realms/master
# 即默认 http://localhost:8180/realms/master
# 不要改成 http://keycloak:8080，否则和浏览器拿到的 iss 不一致，请求会 401。
KC_HOSTNAME=http://localhost:8180

# ============================================
# JWT（compose 以 prod profile 启动应用时必填）
# 对应 main 上的 app.security.jwt.issuer / jwk-set-uri / audience。
# 非 dev/local profile 三者缺一，应用拒绝启动。
# ============================================
# 必须与 token 里的 iss 逐字相同：${KC_HOSTNAME}/realms/master
JWT_ISSUER_URI=http://localhost:8180/realms/master

# 应用容器拉取公钥的地址。用 compose 服务名和容器端口 8080。
# 容器内的 localhost 不是 Keycloak，不要写成 localhost:8180。
JWT_JWK_SET_URI=http://keycloak:8080/realms/master/protocol/openid-connect/certs

# 期望受众。令牌 aud 包含该值，或 azp 等于该值，才通过。
# 应对齐签发令牌的 Keycloak 客户端 ID。本仓库约定客户端 ID 为 image-text-analyzer。
# start-dev 只自带 master realm，不会自动创建这个客户端，需要在 realm 里另行创建。
JWT_AUDIENCE=image-text-analyzer
