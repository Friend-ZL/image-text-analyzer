<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="image-text-analyzer"/>
    
    <!-- 可读格式日志 Appender（用于本地开发） -->
    <appender name="CONSOLE_READABLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [traceId=%X{traceId:-} requestId=%X{requestId:-}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <!-- JSON 格式日志 Appender（用于生产环境） -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <customFields>{"app":"${APP_NAME}"}</customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>version</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>
    
    <!-- 生产环境：使用 JSON 格式 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
        <logger name="com.portfolio.analyzer" level="INFO"/>
    </springProfile>
    
    <!-- 非生产环境（default, dev, test, staging 等）：使用可读格式 -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE_READABLE"/>
        </root>
        <logger name="com.portfolio.analyzer" level="DEBUG"/>
    </springProfile>
</configuration>
